# Local configuration; never store a password or commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Image-input model; verified by an image preflight before motion.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
CAMERA_VISION_URL=http://127.0.0.1:8767
# For real read-only previews, set SSH_HOST to the printer's current IP.
SSH_HOST=
SSH_CONTROL_PATH=/tmp/photonics-printer-control
# Operator-controlled real execution gate. Leave at 0 until a path is reviewed.
PRINTER_ALLOW_MOTION=0
