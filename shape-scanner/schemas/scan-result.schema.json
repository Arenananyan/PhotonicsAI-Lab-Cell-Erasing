{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CellCounts": {
      "properties": {
        "defective": {
          "title": "Defective",
          "type": "integer"
        },
        "healthy": {
          "title": "Healthy",
          "type": "integer"
        }
      },
      "required": [
        "defective",
        "healthy"
      ],
      "title": "CellCounts",
      "type": "object"
    },
    "CellDetection": {
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "detection_id": {
          "title": "Detection Id",
          "type": "string"
        },
        "label": {
          "enum": [
            "defective",
            "healthy"
          ],
          "title": "Label",
          "type": "string"
        },
        "color": {
          "enum": [
            "red",
            "blue",
            "green"
          ],
          "title": "Color",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "center": {
          "$ref": "#/$defs/Center"
        },
        "area_px2": {
          "title": "Area Px2",
          "type": "number"
        },
        "touches_image_edge": {
          "title": "Touches Image Edge",
          "type": "boolean"
        },
        "printer_coordinates_mm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Center"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "area_mm2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area Mm2"
        },
        "calibration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Id"
        },
        "calibration_status": {
          "default": "not_calibrated",
          "title": "Calibration Status",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "detection_id",
        "label",
        "color",
        "bbox",
        "center",
        "area_px2",
        "touches_image_edge"
      ],
      "title": "CellDetection",
      "type": "object"
    },
    "Center": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Center",
      "type": "object"
    },
    "FrameInfo": {
      "properties": {
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "acquired_at": {
          "title": "Acquired At",
          "type": "string"
        },
        "source": {
          "enum": [
            "camera",
            "file",
            "demo",
            "upload",
            "view"
          ],
          "title": "Source",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "raw_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Image"
        },
        "camera_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        }
      },
      "required": [
        "frame_id",
        "acquired_at",
        "source",
        "width",
        "height"
      ],
      "title": "FrameInfo",
      "type": "object"
    },
    "GridReference": {
      "properties": {
        "cell_side_mm": {
          "default": 4.0,
          "title": "Cell Side Mm",
          "type": "number"
        },
        "source": {
          "const": "user_provided",
          "default": "user_provided",
          "title": "Source",
          "type": "string"
        },
        "used_for_calibration": {
          "default": false,
          "title": "Used For Calibration",
          "type": "boolean"
        }
      },
      "title": "GridReference",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ok": {
      "const": true,
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "frame_id": {
      "title": "Frame Id",
      "type": "string"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "frame": {
      "$ref": "#/$defs/FrameInfo"
    },
    "coordinate_space": {
      "const": "image_pixels",
      "default": "image_pixels",
      "title": "Coordinate Space",
      "type": "string"
    },
    "pixel_origin": {
      "const": "top_left",
      "default": "top_left",
      "title": "Pixel Origin",
      "type": "string"
    },
    "defective_color": {
      "default": "red",
      "enum": [
        "red",
        "blue"
      ],
      "title": "Defective Color",
      "type": "string"
    },
    "reference_grid": {
      "$ref": "#/$defs/GridReference"
    },
    "counts": {
      "$ref": "#/$defs/CellCounts"
    },
    "detections": {
      "items": {
        "$ref": "#/$defs/CellDetection"
      },
      "title": "Detections",
      "type": "array"
    },
    "annotated_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotated Image"
    },
    "result_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Json"
    },
    "method": {
      "default": "HSV color segmentation and contour geometry",
      "title": "Method",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "calibration": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration"
    }
  },
  "required": [
    "frame_id",
    "analysis_id",
    "frame",
    "counts",
    "detections"
  ],
  "title": "ScanResult",
  "type": "object"
}
